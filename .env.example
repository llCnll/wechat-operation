# 复制到 runtime/.env 后按需修改。此文件只能包含示例值，不得放入真实密钥或业务数据。

# 部署启动配置
# 完成依赖同步后，用 uv run python -c "import secrets; print(secrets.token_urlsafe(50))" 生成并粘贴唯一密钥。
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
WEB_PORT=8000
DATABASE_PATH=runtime/operations.sqlite3
SQLITE_BUSY_TIMEOUT_MS=5000
LOG_LEVEL=INFO

# 受控 Chrome 由 Supervisor 启停，首次启动后在独立资料目录中人工扫码。
# 留空时按操作系统常见位置查找 Chrome；否则填写完整可执行文件路径。
CONTROLLED_CHROME_BIN=
# 相对路径按项目根目录解析，不要与日常手动 Chrome 共用资料目录。
CONTROLLED_CHROME_USER_DATA_DIR=runtime/controlled-chrome-profile
CONTROLLED_CHROME_DEBUG_PORT=9222

# 游戏圈会话服务本机 IPC；监听地址固定为 127.0.0.1，勿向局域网或公网开放。
GAME_CIRCLE_IPC_PORT=9364
GAME_CIRCLE_IPC_TIMEOUT_SECONDS=30
GAME_CIRCLE_SESSION_RETIRE_SECONDS=10
# 当前已验证只读流程默认不限制并发；按上游已确认的限额设置，0 表示不限。
GAME_CIRCLE_MAX_CONCURRENT_ACCESSES=0

# 自动采集调度
SCHEDULED_INGESTION_INTERVAL_MINUTES=15
SCHEDULED_INGESTION_LOOKBACK_MINUTES=30
SCHEDULED_INGESTION_PAGE_SIZE=100

# OpenAI 兼容 AI 接口
AI_BASE_URL=https://your-ai-endpoint/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=30

# 可选：独立 OCR 接口
OCR_BASE_URL=https://your-ocr-endpoint/v1
OCR_API_KEY=
OCR_MODEL=

# 可选：视频审核。默认关闭；启用前完成无 Cookie 视频读取预检。
VIDEO_ENABLED=false
VIDEO_PREFLIGHT_VERIFIED=false
# ffmpeg 与 ffprobe 所在目录；相对路径必须位于 runtime/ 内。留空时使用系统 PATH。
VIDEO_MEDIA_TOOLS_DIR=
VIDEO_MAX_BYTES=52428800
VIDEO_MAX_DURATION_SECONDS=30
VIDEO_MAX_PER_POST=3
VIDEO_MAX_FRAME_EDGE=960
VIDEO_DHASH_THRESHOLD=24
VIDEO_OCR_FRAME_BUDGET=60
VIDEO_CONNECT_TIMEOUT_SECONDS=10
VIDEO_READ_TIMEOUT_SECONDS=30
VIDEO_PROCESSING_TIMEOUT_SECONDS=120

# 可选：独立语音转写接口
ASR_BASE_URL=
ASR_API_KEY=
ASR_MODEL=
ASR_TIMEOUT_SECONDS=60
ASR_ENABLED=false

# 管理台动态运行开关。部署模板中的 false 值是安全初始状态。
PUBLIC_OPINION_CONCLUSION_ENABLED=false
SESSION_REPAIR_ENABLED=false
# 未完成每个上游写接口验证前必须保持 false；每项已验证操作仍需单独开启。
ENABLE_UPSTREAM_WRITES=false
ENABLE_SINK_WRITES=false
ENABLE_BLOCK_WRITES=false
ENABLE_MUTE_WRITES=false
ENABLE_UNMUTE_WRITES=false
ENABLE_RESTORE_WRITES=false
ENABLE_AI_AUTOMATED_MODERATION=false
ENABLE_AI_SINK_WRITES=false
ENABLE_AI_BLOCK_WRITES=false
